{
  "name": "eterna-ninefold",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "description": "Eterna Ninefold — action RPG 3D procedural com nove classes, mundo aberto e Android.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew --no-daemon --max-workers=2 assembleDebug",
    "android:open": "cap open android",
    "server": "tsx server/index.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "cannon-es": "0.20.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "^24.0.0",
    "@types/three": "0.186.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
